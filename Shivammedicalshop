<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>शिवम मेडिकल करूप बाजार</title>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* CSS STYLES */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f4f9f9;
            color: #333;
        }

        /* Header & Logo Section */
        header {
            background-color: #008080;
            color: white;
            padding: 15px 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .nav-container {
            max-width: 1100px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .logo-icon {
            width: 50px;
            height: 50px;
            background-color: white;
            color: #008080;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 28px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        }

        .logo-text h1 {
            font-size: 24px;
            font-weight: bold;
            margin-bottom: 2px;
        }

        .logo-text p {
            font-size: 13px;
            color: #e0f2f1;
        }

        /* Hero Section */
        .hero {
            background: linear-gradient(rgba(0, 128, 128, 0.85), rgba(0, 100, 100, 0.85)), url('https://images.unsplash.com/photo-1576602976047-174e57a47881?auto=format&fit=crop&q=80&w=1000') center/cover;
            color: white;
            text-align: center;
            padding: 50px 20px;
        }

        .hero h2 {
            font-size: 30px;
            margin-bottom: 10px;
        }

        .hero p {
            font-size: 16px;
            max-width: 600px;
            margin: 0 auto;
        }

        /* Container */
        .container {
            max-width: 900px;
            margin: 30px auto;
            padding: 0 20px;
        }

        /* Contact Section Card */
        .contact-card {
            background: white;
            padding: 30px 20px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
            text-align: center;
            margin-bottom: 30px;
        }

        .contact-card h3 {
            color: #008080;
            margin-bottom: 10px;
            font-size: 22px;
        }

        .phone-number-display {
            font-size: 18px;
            font-weight: bold;
            color: #555;
            margin-bottom: 25px;
            background: #eef9f6;
            padding: 10px;
            border-radius: 6px;
            display: inline-block;
        }

        .buttons-group {
            display: flex;
            justify-content: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 14px 28px;
            border: none;
            border-radius: 30px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            box-shadow: 0 3px 8px rgba(0,0,0,0.15);
        }

        .btn-call {
            background-color: #007bff;
            color: white;
        }

        .btn-call:hover {
            background-color: #0056b3;
            transform: translateY(-2px);
        }

        .btn-whatsapp {
            background-color: #25D366;
            color: white;
        }

        .btn-whatsapp:hover {
            background-color: #1eaf53;
            transform: translateY(-2px);
        }

        /* Features Section */
        .features {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 20px;
            margin-top: 30px;
        }

        .feature-box {
            background: white;
            padding: 20px;
            border-radius: 8px;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        .feature-box i {
            font-size: 35px;
            color: #008080;
            margin-bottom: 10px;
        }

        /* Location Section */
        .location-info {
            background: white;
            padding: 20px;
            border-radius: 8px;
            margin-top: 20px;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        /* Footer */
        footer {
            background-color: #222;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 40px;
        }

        @media (max-width: 600px) {
            .logo-text h1 { font-size: 18px; }
            .hero h2 { font-size: 22px; }
            .btn { width: 100%; justify-content: center; }
            .buttons-group { flex-direction: column; }
        }
    </style>
</head>
<body>

    <!-- Header Section -->
    <header>
        <div class="nav-container">
            <div class="logo-container">
                <div class="logo-icon">
                    <i class="fa-solid fa-prescription-bottle-medical"></i>
                </div>
                <div class="logo-text">
                    <h1>शिवम मेडिकल करूप बाजार </h1>
                    <p><i class="fa-solid fa-location-dot"></i> करूप, गोडारी</p>
                </div>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="hero">
        <h2>आपकी सेहत, हमारी प्राथमिकता</h2>
        <p>उच्च गुणवत्ता वाली दवाइयां एवं मेडिकल सामान उचित मूल्य पर उपलब्ध हैं।</p>
    </section>

    <!-- Main Content -->
    <div class="container">
        
        <!-- Contact Section -->
        <div class="contact-card">
            <h3>संपर्क करें (Contact Us)</h3>
            <div class="phone-number-display">
                <i class="fa-solid fa-store"></i> शिवम मेडिकल करूप बाजार : <span id="display-number">+91 9876543210</span>
            </div>
            
            <div class="buttons-group">
                <!-- Call Button: directly opens dialer app -->
                <a id="call-btn" href="#" class="btn btn-call">
                    <i class="fa-solid fa-phone-flip"></i> कॉल करें
                </a>

                <!-- WhatsApp Button: directly opens WhatsApp app to chat/add contact -->
                <a id="whatsapp-btn" href="#" target="_blank" class="btn btn-whatsapp">
                    <i class="fa-brands fa-whatsapp"></i> WhatsApp पर संपर्क करें
                </a>
            </div>
        </div>

        <!-- Features -->
        <div class="features">
            <div class="feature-box">
                <i class="fa-solid fa-pills"></i>
                <h4>ऑरिजिनल दवाइयां</h4>
                <p>सभी प्रकार की प्रामाणिक दवाइयां उपलब्ध हैं।</p>
            </div>
            <div class="feature-box">
                <i class="fa-solid fa-truck-medical"></i>
                <h4>त्वरित सेवा</h4>
                <p>दवाइयों की त्वरित उपलब्धता और बेहतर सेवा।</p>
            </div>
            <div class="feature-box">
                <i class="fa-solid fa-kit-medical"></i>
                <h4>मेडिकल परामर्श</h4>
                <p>जरूरी प्राथमिक सहायता और परामर्श सुविधा।</p>
            </div>
        </div>

        <!-- Location Box -->
        <div class="location-info">
            <h3 style="color: #008080; margin-bottom: 8px;"><i class="fa-solid fa-map-location-dot"></i> दुकान का पता</h3>
            <p><strong> शिवम मेडिकल करूप बाजार</strong>, करूप बाजार, गोडारी (802214)</p>
        </div>

    </div>

    <!-- Footer -->
    <footer>
        <p>&copy; 2026 शिवम मेडिकल करूप बाजार। सर्वाधिकार सुरक्षित।</p>
    </footer>

    <!-- JAVASCRIPT CODE -->
    <script>
        // ==========================================
        // यहाँ अपना 10 अंकों का मोबाइल नंबर डालें
        // ==========================================
        const myPhoneNumber = "**********"; // <--- यहाँ अपना नंबर अपडेट करें

        // ऑटोमैटिक लिंक्स सेट करने का फंक्शन
        function setupContactLinks() {
            // 1. स्क्रीन पर नंबर दिखाना
            document.getElementById('display-number').innerText = "+91 " + myPhoneNumber;

            // 2. कॉल लिंक (फोन डायल करने के लिए)
            const callBtn = document.getElementById('call-btn');
            callBtn.href = "tel:+91" + myPhoneNumber;

            // 3. व्हाट्सएप लिंक (सीधे चैट खोलने/कांटेक्ट सेव करने के लिए)
            const whatsappBtn = document.getElementById('whatsapp-btn');
            const message = encodeURIComponent("नमस्ते शिवम मेडिकल, करूप बाजार");
            whatsappBtn.href = "https://api.whatsapp.com/send?phone=91" + myPhoneNumber + "&text=" + message;
        }

        // पेज लोड होते ही लिंक सेट हो जाएँगे
        window.onload = setupContactLinks;
    </script>
</body>
</html>
